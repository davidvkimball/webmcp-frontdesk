# Twilio: owner and customer messaging for book_appointment and the confirm webhook.
# Set these as Netlify environment variables. Never commit real values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Two ways to run this, and the channel is decided entirely by the prefix on
# these two values. The code path is identical either way.
#
# 1. WhatsApp sandbox, recommended for the demo. Free, works the same day, and
#    needs no A2P 10DLC registration, which is a paid account plus carrier
#    vetting that can take days.
#      TWILIO_FROM_NUMBER=whatsapp:+14155238886      (the shared sandbox number)
#      OWNER_SMS_NUMBER=whatsapp:+12535550142        (the owner, after joining the sandbox)
#
# 2. Real SMS. Needs a paid account, a purchased number, and a registered
#    A2P 10DLC campaign before US carriers will deliver anything.
#      TWILIO_FROM_NUMBER=+12535550142
#      OWNER_SMS_NUMBER=+12535550199
TWILIO_FROM_NUMBER=

# The owner's real number. Never rendered on the site and never returned by any
# tool. This is what receives the booking request and replies YES or NO.
OWNER_SMS_NUMBER=
