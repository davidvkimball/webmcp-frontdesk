# GitHub OAuth App credentials for CMS authentication
# Create at: https://github.com/settings/applications/new
# Homepage URL: your production domain
# Callback URL: https://your-domain.com/oauth/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Optional: GitHub App repo ID (for scoped access)
# Get with: curl -s 'https://api.github.com/repos/OWNER/REPO' | jq .id
OAUTH_GITHUB_REPO_ID=
