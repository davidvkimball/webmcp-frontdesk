# Twilio: owner and customer SMS for book_appointment and the confirm webhook.
# Set these as Netlify environment variables. Never commit real values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number that sends messages, in E.164 format, e.g. +12535550142
TWILIO_FROM_NUMBER=
# The owner's real mobile, in E.164. Never rendered on the site or returned
# by any tool. This is the number that receives booking confirmations.
OWNER_SMS_NUMBER=
