---
/**
 * Header: site-wide navigation.
 *
 * The logo is an inline SVG lockup rather than an uploaded image: a droplet
 * cut by the line of a creek, which is the name. Inline means no image
 * request, no layout shift, and it inherits colour from CSS so it works in
 * any theme. The starter's CMS-image logo branch is gone with the CMS.
 */
import { getEntry } from 'astro:content';

const settings = await getEntry('settings', 'site');
const { header, siteName } = settings.data;
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="header-logo" aria-label={`${header.siteName || siteName}, home`}>
      <svg class="logo-mark" viewBox="0 0 32 32" width="30" height="30" aria-hidden="true" focusable="false">
        <path
          d="M16 2.5c0 0 9 10.1 9 15.6a9 9 0 1 1-18 0C7 12.6 16 2.5 16 2.5Z"
          fill="none"
          stroke="currentColor"
          stroke-width="2.1"
          stroke-linejoin="round"
        />
        <path
          d="M8.4 19.4c1.6 0 1.6-1.9 3.2-1.9s1.6 1.9 3.2 1.9 1.6-1.9 3.2-1.9 1.6 1.9 3.2 1.9 1.6-1.9 3.2-1.9"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        />
      </svg>
      <span class="logo-text">
        <strong>Clarks Creek</strong>
        <span class="logo-sub">Plumbing</span>
      </span>
    </a>

    <button
      type="button"
      class="nav-toggle"
      aria-controls="primary-nav"
      aria-expanded="false"
      aria-label="Menu"
    >
      <span class="nav-toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>

    <nav class="header-nav" id="primary-nav" aria-label="Main navigation">
      <ul class="nav-list">
        {header.menu.map((item: { label: string; href: string }) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link', { active: currentPath.startsWith(item.href) && item.href !== '/' }]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {header.ctaLink && (
      <a
        href={header.ctaLink}
        class="btn btn-primary header-cta"
        data-testid="button-header-cta"
      >
        {header.ctaLabel || 'Get Started'}
      </a>
    )}
  </div>
</header>

<style>
  /* Structural only. Add brand colors/borders per project */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-white);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-block: var(--space-md);
  }

  .header-logo {
    /* Sized by its content. The starter's fixed 120px box clipped the
       wordmark, which is what "broken logo" actually was. */
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    color: var(--color-primary, #0f4c5c);
    text-decoration: none;
    line-height: 1;
  }

  .logo-mark {
    flex-shrink: 0;
    display: block;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .logo-text strong {
    font-family: var(--font-heading, inherit);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .logo-sub {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  /* Colour shift only. No scale or grow transforms, ever. */
  .header-logo:hover,
  .header-logo:focus-visible {
    color: var(--color-primary-dark, #0a3542);
  }

  .nav-list {
    display: flex;
    list-style: none;
    gap: var(--space-lg);
  }

  .header-cta {
    padding: 0.5rem 1.25rem;
    font-size: 0.875rem;
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: auto;
    padding: 0;
    background: none;
    border: 1px solid var(--color-line, rgba(0, 0, 0, 0.14));
    border-radius: 0.5rem;
    color: var(--color-primary, #0f4c5c);
    cursor: pointer;
  }

  .nav-toggle:hover,
  .nav-toggle:focus-visible {
    background: var(--color-tint, rgba(15, 76, 92, 0.07));
  }

  .nav-toggle-bars {
    display: block;
    width: 1.125rem;
  }

  .nav-toggle-bars span {
    display: block;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
  }

  .nav-toggle-bars span + span {
    margin-top: 4px;
  }

  /* Narrow viewports matter more than usual here: ChatGPT's in-app browser,
     which is the surface this project is judged on, is a phone-width window.
     At 375px the logo, the call to action and the menu button came to two
     pixels more than the row could hold, so the call to action wrapped onto
     its own line and the sticky header ate 118px of an 812px screen. The
     order also put the menu button between the logo and the call to action,
     which is not where either belongs. */
  @media (max-width: 768px) {
    .header-inner {
      flex-wrap: wrap;
      gap: var(--space-sm, 0.5rem);
    }

    .nav-toggle {
      display: inline-flex;
      order: 3;
      margin-left: 0;
    }

    .header-nav {
      display: none;
      flex-basis: 100%;
      order: 3;
    }

    .header-nav.is-open {
      display: block;
      padding-block: var(--space-sm, 0.75rem);
      border-top: 1px solid var(--color-line, rgba(0, 0, 0, 0.12));
    }

    .nav-list {
      flex-direction: column;
      gap: 0;
    }

    .nav-list a {
      display: block;
      padding-block: 0.6rem;
    }

    .header-cta {
      order: 2;
      margin-left: auto;
    }
  }

  @media (max-width: 480px) {
    .header-inner {
      padding-block: 0.7rem;
    }

    /* Taller, not wider: 34px was under a comfortable thumb target and the
       row has no horizontal slack to give. Written as the padding shorthand
       because the longhand pair collides with the shorthand on the base rule
       and the CSS minifier drops the block half of it. */
    .header-cta {
      padding: 0.7rem 0.85rem;
    }

    .nav-toggle {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>

<script>
  function wireNav() {
    const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
    const nav = document.getElementById('primary-nav');
    if (!toggle || !nav) return;

    const setOpen = (open: boolean) => {
      nav.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    setOpen(false);
    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    // A tap on a link should close the menu, including on same-page anchors
    // where the client router never swaps and would otherwise leave it open.
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });
  }

  document.addEventListener('astro:page-load', wireNav);
</script>
