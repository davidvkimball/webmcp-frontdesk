---
/**
 * Registers this site's tools with the browser's WebMCP model context.
 *
 * Two lifecycles run here, and they are the interesting part of this project.
 *
 * The PAGE lifecycle: the site uses Astro's ClientRouter, so a plain bundled
 * script would run once and go stale across client-side navigations.
 * Registration happens on every astro:page-load and is torn down on
 * astro:before-swap through an AbortController, which is the documented
 * unregister path rather than a workaround.
 *
 * The CONVERSATION lifecycle: two tools, check_hold_status and cancel_hold,
 * do not exist when the page loads. They are registered the moment a booking
 * produces a hold, and unregistered the moment that hold stops being pending.
 * The tool surface therefore describes what is currently possible instead of
 * listing everything that could ever be possible and relying on the model to
 * check first. An agent cannot cancel a booking that was never made, because
 * there is no cancel tool to call.
 */
---

<script>
  type Parsed = Record<string, any>;

  type ToolSpec = {
    name: string;
    description: string;
    endpoint: string;
    properties: Record<string, { type: string; description: string }>;
    required: string[];
    readOnly: boolean;
    /** Runs after a successful call, so a tool can change the tool surface. */
    onResult?: (parsed: Parsed) => void;
  };

  /**
   * Descriptions are read by the model to decide whether and how to call a
   * tool, so they are written as prompts rather than as documentation. Each
   * one says what the tool does, when to reach for it, and what it gives back.
   */
  const TOOLS: ToolSpec[] = [
    {
      name: 'check_service_area',
      description:
        'Check whether Clarks Creek Plumbing travels to a given address, city or ZIP code in the Puyallup, Washington area. Call this before checking availability or booking anything, because nothing else matters if the plumber will not drive there. Returns whether the location is covered, how far it is from the shop, and any travel fee that applies.',
      endpoint: '/api/service-area',
      properties: {
        location: {
          type: 'string',
          description:
            'Where the job is. A city name, a 5 digit ZIP code, or a street address. For example "Puyallup", "98371", or "1204 39th Ave SE, Puyallup WA".',
        },
      },
      required: ['location'],
      readOnly: true,
    },
    {
      name: 'check_availability',
      description:
        'Find real open appointment windows on a given date. Every window returned can actually be booked, and windows already taken are never returned. Call this after confirming the address is in the service area. Returns two hour arrival windows, or a clear reason when the day is closed or fully booked.',
      endpoint: '/api/availability',
      properties: {
        date: {
          type: 'string',
          description:
            'The day to check, in ISO format YYYY-MM-DD. Convert whatever the customer said, such as "tomorrow" or "next Tuesday", into this format first.',
        },
        service: {
          type: 'string',
          description:
            'What is wrong, in the words the customer used. For example "clogged kitchen drain", "no hot water", or "toilet running". Optional, but it lets the answer flag emergency handling.',
        },
      },
      required: ['date'],
      readOnly: true,
    },
    {
      name: 'estimate_job',
      description:
        'Get the price range for a plumbing job before booking it. Returns a low and high figure plus the diagnostic fee, and is explicit that the final price comes after someone sees the job. Use this when the customer asks what something costs. Do not present the range as a quote.',
      endpoint: '/api/estimate',
      properties: {
        job: {
          type: 'string',
          description:
            'The job or the symptom, in plain words. For example "water heater replacement", "clogged drain", "leak under the sink".',
        },
        details: {
          type: 'string',
          description:
            'Anything else the customer mentioned that affects the job, such as the age of the fixture or whether water is actively running. Optional.',
        },
      },
      required: ['job'],
      readOnly: true,
    },
    {
      name: 'describe_services',
      description:
        'Get everything about the business at once: the services offered with price ranges, opening hours, the service area, the emergency policy, and licence details. Call this to answer general questions about the business rather than guessing from the page text.',
      endpoint: '/api/services',
      properties: {},
      required: [],
      readOnly: true,
    },
    {
      name: 'book_appointment',
      description:
        'Request an appointment in a specific open window. This does NOT confirm the booking. It holds the slot, texts the owner, and returns a reference while it waits for him to confirm, usually within a few minutes. Tell the customer it is pending rather than booked. Check the service area and availability first, and only pass a window this site actually returned.',
      endpoint: '/api/book',
      properties: {
        name: { type: 'string', description: 'The full name of the customer.' },
        phone: { type: 'string', description: 'A phone number the plumber can reach them on.' },
        address: { type: 'string', description: 'The street address where the work is needed, including the city.' },
        service: { type: 'string', description: 'What is wrong, in the words the customer used.' },
        date: { type: 'string', description: 'The appointment date in ISO format YYYY-MM-DD.' },
        slot: { type: 'string', description: 'The start of the arrival window in 24 hour HH:mm form, exactly as check_availability returned it. For example "08:00".' },
      },
      required: ['name', 'phone', 'address', 'service', 'date', 'slot'],
      readOnly: false,
      // A successful booking grows the tool surface.
      onResult: (parsed) => {
        if (parsed?.ok && typeof parsed.reference === 'string') openHoldTools(parsed.reference);
      },
    },
  ];

  /** Page lifecycle. Aborted on navigation. */
  let pageController: AbortController | null = null;
  /** Conversation lifecycle. Aborted when the hold stops being pending. */
  let holdController: AbortController | null = null;

  async function call(endpoint: string, params: unknown, signal?: AbortSignal): Promise<string> {
    const res = await fetch(endpoint, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(params ?? {}),
      // Passing the agent's signal through means a cancelled agent request
      // cancels the network call, rather than leaving it running and
      // discarding the answer.
      signal,
    });
    return JSON.stringify(await res.json());
  }

  function register(spec: ToolSpec, signal: AbortSignal) {
    return document.modelContext!.registerTool(
      {
        name: spec.name,
        description: spec.description,
        inputSchema: { type: 'object', properties: spec.properties, required: spec.required },
        annotations: {
          // Only ever true where it is actually true. Claiming read-only on a
          // tool that changes state makes the browser skip a confirmation it
          // should have shown, which is a lie with consequences.
          readOnlyHint: spec.readOnly,
        },
        execute: async (params, options) => {
          const raw = await call(spec.endpoint, params, options?.signal);
          if (spec.onResult) {
            try {
              spec.onResult(JSON.parse(raw));
            } catch {
              // A tool must still return its answer even if the surface
              // update fails. The agent's job is more important than ours.
            }
          }
          return raw;
        },
      },
      { signal }
    );
  }

  /**
   * Register the two tools that only make sense while a hold is pending.
   *
   * Scoped to one hold at a time on purpose. A second booking replaces the
   * first one's tools rather than accumulating a tool per reference, which
   * would bloat the surface and force the model to pick between near-identical
   * names.
   */
  function openHoldTools(reference: string) {
    if (!document.modelContext || !pageController) return;

    holdController?.abort();
    holdController = new AbortController();
    const { signal } = holdController;

    const closeIfResolved = (parsed: Parsed) => {
      // Anything other than still-pending means these tools no longer apply.
      if (parsed?.ok === false || (parsed?.status && parsed.status !== 'held')) closeHoldTools();
    };

    void document.modelContext.registerTool(
      {
        name: 'check_hold_status',
        description:
          `Check whether booking ${reference} has been confirmed by the owner yet. This tool exists only while that booking is pending, so if you can see it, the booking is still waiting. Call it when the customer asks whether they are booked. Returns confirmed, still pending, declined, or expired.`,
        inputSchema: {
          type: 'object',
          properties: {
            reference: {
              type: 'string',
              description: `The booking reference. For this conversation it is ${reference}.`,
            },
          },
          required: ['reference'],
        },
        annotations: { readOnlyHint: true },
        execute: async (params, options) => {
          const raw = await call('/api/hold-status', { reference: params?.reference ?? reference }, options?.signal);
          try {
            closeIfResolved(JSON.parse(raw));
          } catch {}
          return raw;
        },
      },
      { signal }
    );

    void document.modelContext.registerTool(
      {
        name: 'cancel_hold',
        description:
          `Cancel pending booking ${reference} and give the window back. This tool exists only while that booking is still pending: once the owner confirms it, this tool disappears and a confirmed job can only be changed by phoning the shop. Use this if the customer changes their mind before the owner replies.`,
        inputSchema: {
          type: 'object',
          properties: {
            reference: {
              type: 'string',
              description: `The booking reference to cancel. For this conversation it is ${reference}.`,
            },
          },
          required: ['reference'],
        },
        // This one genuinely changes state, so no read-only claim.
        annotations: { readOnlyHint: false },
        execute: async (params, options) => {
          const raw = await call('/api/cancel-hold', { reference: params?.reference ?? reference }, options?.signal);
          try {
            const parsed = JSON.parse(raw);
            if (parsed?.ok) closeHoldTools();
            else closeIfResolved(parsed);
          } catch {}
          return raw;
        },
      },
      { signal }
    );
  }

  function closeHoldTools() {
    holdController?.abort();
    holdController = null;
  }

  async function registerTools() {
    if (!document.modelContext) return; // No agent present. Nothing to do.

    pageController?.abort();
    closeHoldTools();
    pageController = new AbortController();

    await Promise.all(TOOLS.map((spec) => register(spec, pageController!.signal)));
  }

  document.addEventListener('astro:page-load', registerTools);
  document.addEventListener('astro:before-swap', () => {
    closeHoldTools();
    pageController?.abort();
  });
</script>
