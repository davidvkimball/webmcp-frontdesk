---
/**
 * BaseHead: drop into <head> of every page.
 * Handles: meta, OG, Twitter Card, canonical, robots, JSON-LD slot,
 * View Transitions.
 *
 * Pattern: davidvkimball.com BaseHead.astro
 *
 * Image handling: `image` prop accepts either a URL string OR an
 * ImageMetadata object (e.g., from `image()` schema or a static import).
 * The `og:image` meta is only emitted if a usable URL is available, so
 * pages without a social image just skip the tag instead of emitting
 * a broken URL.
 */
import type { ImageMetadata } from 'astro';
import { ClientRouter } from 'astro:transitions';
import { getEntry } from 'astro:content';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string | ImageMetadata;
  noIndex?: boolean;
  type?: 'website' | 'article';
  publishDate?: string;
}

const settings = await getEntry('settings', 'site');
const site = settings.data;

const {
  title,
  description = site.siteDescription,
  image = site.ogImage,
  noIndex = false,
  type = 'website',
  publishDate,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Image can be a string URL (page-supplied) or ImageMetadata (from
// image() schema / static import). Normalize to a usable URL or undefined.
const ogImageSrc: string | undefined =
  typeof image === 'string' ? image : image?.src;
const ogImageURL: URL | undefined = ogImageSrc
  ? new URL(ogImageSrc, Astro.site)
  : undefined;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5" />
<meta name="generator" content={Astro.generator} />

<!-- SEO -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noIndex
  ? <meta name="robots" content="noindex, nofollow" />
  : <meta name="robots" content="index, follow" />
}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{ogImageURL && <meta property="og:image" content={ogImageURL} />}
{type === 'article' && publishDate && (
  <meta property="article:published_time" content={publishDate} />
)}

<!-- Twitter Card -->
<meta name={ogImageURL ? 'twitter:card' : 'twitter:card'} content={ogImageURL ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

<!-- Favicon -->
<link rel="icon" type="image/png" href="/favicon.png" />

<!-- Sitemap & RSS (uncomment RSS when blog is enabled) -->
<link rel="sitemap" href="/sitemap-index.xml" />
<!-- <link rel="alternate" type="application/rss+xml" title="Blog RSS" href="/rss.xml" /> -->

<!-- View Transitions: smooth page swaps without full reload flicker -->
<ClientRouter />

<!-- JSON-LD slot: pages inject structured data here -->
<slot name="head" />
