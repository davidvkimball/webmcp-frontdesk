---
/**
 * Where the contact form lands after a human submits it. The form has posted
 * to /thank-you/ since the starter, so this page has to exist or every real
 * submission ends on a 404.
 */
import Layout from '@layouts/Layout.astro';
import { BUSINESS, HOURS } from '@lib/business';
---

<Layout title={`Message received | ${BUSINESS.name}`} noIndex={true}>
  <section class="thanks">
    <div class="container container-narrow">
      <span class="eyebrow">Message received</span>
      <h1>Thanks, we have got it.</h1>
      <p class="lede">
        {BUSINESS.owner} reads these himself between jobs, so a reply usually comes the same day during working hours rather than the same minute.
      </p>

      <div class="card">
        <h2>If it cannot wait</h2>
        <p>{HOURS.emergency}</p>
        <p>
          For an actual emergency, call rather than wait on the form.
          <a href="tel:+12535550142" class="btn btn-accent" data-testid="button-thanks-call">Call {BUSINESS.phone}</a>
        </p>
      </div>

      <p class="back"><a href="/">Back to the home page</a></p>
    </div>
  </section>
</Layout>

<style>
  .thanks {
    padding-block: var(--section-y-lg);
  }

  .thanks h1 {
    margin-block: var(--space-sm, 0.5rem) var(--space-md, 1rem);
  }

  /* Same accent treatment the emergency blocks carry on the other pages, so
     the one thing on this page that is urgent looks urgent. */
  .card {
    margin-block: var(--space-xl);
    padding: var(--space-xl);
    background: var(--color-accent-tint);
    border-color: var(--color-accent-line);
    box-shadow: none;
  }

  .card h2 {
    font-size: 1.25rem;
    margin-bottom: var(--space-sm);
  }

  .card p {
    color: var(--color-gray-700);
    max-width: var(--measure);
  }

  /* Flex rather than inline-flex, so the button drops onto its own line
     instead of sitting inline with the sentence above it. */
  .card .btn {
    display: flex;
    width: fit-content;
    margin-top: var(--space-md);
  }

  @media (max-width: 560px) {
    .card {
      padding: var(--space-lg);
    }

    .card .btn {
      width: 100%;
    }
  }

  .back {
    margin-top: var(--space-xl, 2rem);
  }
</style>
