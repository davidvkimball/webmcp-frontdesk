---
/**
 * Layout: wraps every page.
 * Includes: BaseHead, Header, Footer, the WebMCP tool registrations,
 * and the hidden Netlify form definition.
 */
import BaseHead from '@components/BaseHead.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import WebMCP from '@components/WebMCP.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
  type?: 'website' | 'article';
  publishDate?: string;
}

const props = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead {...props}>
      <slot name="head" slot="head" />
    </BaseHead>

  </head>
  <body>
    {/* Hidden form definitions for Netlify build-time detection.
        Mirror every form name + field names used by interactive components.
        See §23 in SKILL.md for details. */}
    <form name="contact" netlify netlify-honeypot="bot-field" hidden>
      <input name="bot-field" />
      <input name="name" />
      <input name="email" />
      <input name="phone" />
      <input name="message" />
    </form>

    <WebMCP />

    <Header />
    <main>
      <slot />
    </main>
    <Footer />


  </body>
</html>
